  "fixed_sql": [
    {
      "name": "local_accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_accounts\" (\"account_id\" TEXT NOT NULL, \"login_identifier\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"account_id\"));"
        }
      ]
    },
    {
      "name": "credential_verifiers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"credential_verifiers\" (\"account_id\" TEXT NOT NULL REFERENCES local_accounts (account_id) ON DELETE CASCADE, \"algorithm\" TEXT NOT NULL CHECK (algorithm = 'argon2id'), \"algorithm_version\" TEXT NOT NULL, \"salt\" BLOB NOT NULL UNIQUE, \"verifier\" BLOB NOT NULL, \"memory_ki_b\" INTEGER NOT NULL CHECK (memory_ki_b >= 19456), \"iterations\" INTEGER NOT NULL CHECK (iterations >= 2), \"parallelism\" INTEGER NOT NULL CHECK (parallelism >= 1), \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"account_id\"));"
        }
      ]
    },
    {
      "name": "user_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_preferences\" (\"preference_id\" INTEGER NOT NULL CHECK (preference_id = 1), \"display_language_tag\" TEXT NOT NULL DEFAULT 'en', \"selected_region_id\" TEXT NULL, \"reduced_motion\" INTEGER NULL CHECK (\"reduced_motion\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"preference_id\"));"
        }
      ]
    },
    {
      "name": "footprint_estimates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"footprint_estimates\" (\"estimate_id\" TEXT NOT NULL, \"owner_account_id\" TEXT NULL REFERENCES local_accounts (account_id) ON DELETE CASCADE, \"created_at\" INTEGER NOT NULL, \"period_start\" INTEGER NOT NULL, \"period_end\" INTEGER NOT NULL, \"answers\" TEXT NOT NULL, \"estimate_value\" REAL NOT NULL CHECK (estimate_value >= 0), \"unit\" TEXT NOT NULL, \"questionnaire_version\" TEXT NOT NULL, \"completion_state\" TEXT NOT NULL CHECK (completion_state IN ('complete', 'incomplete')), \"assumptions\" TEXT NOT NULL, PRIMARY KEY (\"estimate_id\"));"
        }
      ]
    },
    {
      "name": "local_accounts_login_identifier_unique",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE UNIQUE INDEX local_accounts_login_identifier_unique ON local_accounts (login_identifier)"
        }
      ]
